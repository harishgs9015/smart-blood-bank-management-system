# Smart Blood Donation & Blood Bank Management System (India)
# Environment Configuration

# Flask Secret Key for sessions and cookie signing
SECRET_KEY=change_this_to_a_secure_random_string_in_production_2026

# MongoDB Connection String:
# For MongoDB Atlas (Production / Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# For Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/smart_blood_bank
# If left empty, the application automatically runs in persistent In-Memory / Demo Mode
MONGO_URI=

# Database Name
DB_NAME=smart_blood_bank

# Optional External API Integrations (stubs enabled if empty)
GOOGLE_MAPS_API_KEY=
SMS_GATEWAY_API_KEY=
WHATSAPP_BUSINESS_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# App Server Settings
FLASK_DEBUG=1
PORT=5000
